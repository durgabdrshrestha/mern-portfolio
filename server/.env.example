PORT=5000
MONGODB_URI=mongodb://localhost:27017/portfolio_db
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

ADMIN_NAME=Portfolio Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=replace_with_your_smtp_password
SMTP_FROM=Portfolio Admin <you@example.com>

# Keep local for development. Use cloudinary on ephemeral/serverless production hosts.
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
